name: notification_firebase_secret
description: Core Secret for the Firebase Cloud Messaging service account
schema_version: 1
version: "{{ version }}"
api_version: v1

requirements:
  core:
    from_version: "0.4.7"

resources:
  $core.secret.secrets:
    service_account:
      name: notification-firebase-service-account
      project_id: "12345678-c625-4fee-81d5-f691897b8142"
      constructor:
        kind: plain

exports:
  service_account:
    kind: resource
    link: "$core.secret.secrets.$service_account"
