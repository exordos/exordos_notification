# Example site configuration manifest for exordos_notification.
#
# Copy to site_config.yaml.j2, fill in your values, and install:
#   exordos em elements install output/manifests/site_config.yaml
#
# This manifest holds all per-installation, configurable content for the
# notification service:
#   * the noreply_address VS variable value (depends on your mail domain)
#
# Install it once after notification_email is active; reinstalling the
# notification element will NOT overwrite these.

name: "notification_site_config_example"
description: "Site-specific configuration for exordos_notification"
schema_version: 1
version: "{{ version }}"
api_version: "v1"

requirements:
  notification_email:
    from_version: "1.2.8-dev"

resources:

  $core.vs.values:
    noreply_address_value:
      name: "notification_noreply_address"
      project_id: "12345678-c625-4fee-81d5-f691897b8142"
      value: "noreply@mail.example.com"
      variable: $notification_site_config_example.imports.$noreply_address_var:uuid
    mail_domain_value:
      name: "notification_mail_domain"
      project_id: "12345678-c625-4fee-81d5-f691897b8142"
      value: "mail.example.com"
      variable: $notification_site_config_example.imports.$mail_domain_var:uuid


imports:
  noreply_address_var:
    element: "$notification_email"
    kind: "resource"
    link: "$core.vs.variables.$noreply_address"
  mail_domain_var:
    element: "$notification_email"
    kind: "resource"
    link: "$core.vs.variables.$mail_domain"
