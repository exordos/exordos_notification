name: "exordos_notification"
description: "Exordos notification element"
schema_version: 1
version: "{{ version }}"
api_version: "v1"

requirements:
  core:
    from_version: "0.0.0"
  dbaas:
    from_version: "2.2.4"
  mailaas:
    from_version: "0.0.0"

resources:

  # IAM
  $core.iam.organizations:
    notification_organization:
      name: "Notification organization"
      description: "Notification organization"

  $core.iam.permissions:
    provider_create:
      name: "exordos_notification.provider.create"
    provider_read:
      name: "exordos_notification.provider.read"
    provider_update:
      name: "exordos_notification.provider.update"
    provider_delete:
      name: "exordos_notification.provider.delete"
    template_create:
      name: "exordos_notification.template.create"
    template_read:
      name: "exordos_notification.template.read"
    template_update:
      name: "exordos_notification.template.update"
    template_delete:
      name: "exordos_notification.template.delete"
    event_type_create:
      name: "exordos_notification.event_type.create"
    event_type_read:
      name: "exordos_notification.event_type.read"
    event_type_update:
      name: "exordos_notification.event_type.update"
    event_type_delete:
      name: "exordos_notification.event_type.delete"
    event_create:
      name: "exordos_notification.event.create"
    event_read:
      name: "exordos_notification.event.read"
    event_update:
      name: "exordos_notification.event.update"
    event_delete:
      name: "exordos_notification.event.delete"

  $core.iam.permissionbinding:
    iam_user_read_all_binding:
      role: $core.iam.roles.$notification_service:uuid
      # iam.user.read_all
      permission: "f64bbebd-c389-53b1-bed2-c725dc7dd1e8"
      project_id: null
    iam_user_list_binding:
      role: $core.iam.roles.$notification_service:uuid
      # iam.user.list
      permission: "a8a7eea2-7514-53ac-a408-8b1235352310"
      project_id: null

  $core.iam.roles:
    notification_service:
      name: "notification_service"
      description: "Notification service role. Grants access to read user data from IAM."
      project_id: null

  $core.iam.users:
    notification_user:
      uuid: 362df68b-c1b6-47bb-95e8-44fceed037d9
      username: notification
      first_name: "Notification system user"
      last_name: "Notification system user"
      email: "noreply+notification@genesis-core.tech"
      password: $core.secret.passwords.$notification_user_password:value

  $core.iam.rolebinding:
    notification_role_binding:
      role: $core.iam.roles.$notification_service:uuid
      user: 362df68b-c1b6-47bb-95e8-44fceed037d9
      project: null

  # DB
  $dbaas.types.postgres.instances:
    notification_cluster_pg:
      name: "notification-pg-cluster"
      nodes_number: 1
      project_id: "12345678-c625-4fee-81d5-f691897b8142"
      cpu: 1
      ram: 2048
      disk_size: 20
      version: $exordos_notification.imports.$pg18:uuid

  $dbaas.types.postgres.instances.$notification_cluster_pg.users:
    notification_db_user:
      project_id: "12345678-c625-4fee-81d5-f691897b8142"
      name: notification_db_user
      password: $core.secret.passwords.$notification_db_password:value
      instance: $dbaas.types.postgres.instances.$notification_cluster_pg:uuid

  $dbaas.types.postgres.instances.$notification_cluster_pg.databases:
    notification_db:
      project_id: "12345678-c625-4fee-81d5-f691897b8142"
      name: notification_db
      owner: $dbaas.types.postgres.instances.$notification_cluster_pg.users.$notification_db_user:uuid
      instance: $dbaas.types.postgres.instances.$notification_cluster_pg:uuid

  # Secret
  $core.secret.passwords:
    notification_db_password:
      name: notification_db_password
      description: "Notification DB password"
      constructor:
        kind: plain
      method: AUTO_HEX

    notification_user_password:
      name: notification_user_password
      description: "Notification system user password"
      project_id: "12345678-c625-4fee-81d5-f691897b8142"
      constructor:
        kind: plain
      method: AUTO_HEX

    notification_smtp_password:
      name: notification_smtp_password
      description: "SMTP account password for the notification mail relay"
      project_id: "12345678-c625-4fee-81d5-f691897b8142"
      constructor:
        kind: plain
      method: AUTO_HEX

  # Mail (mailaas) — dedicated SMTP relay instance for notification
  $mailaas.types.mail.instances:
    notification_mail:
      name: "notification-mail"
      project_id: "12345678-c625-4fee-81d5-f691897b8142"
      domain: f"{$core.vs.variables.$mail_domain:value}"
      cpu: 1
      ram: 1024
      disk_size: 10
      version: $exordos_notification.imports.$exim4_1:uuid

  # SMTP account used by the notification service to send mail.
  # `password` is the plaintext secret; mailaas stores it verbatim (so this
  # target reconciles idempotently) and derives the exim4 crypt hash for the DP.
  $mailaas.types.mail.instances.$notification_mail.accounts:
    smtp_account:
      project_id: "12345678-c625-4fee-81d5-f691897b8142"
      username: "smtp"
      password: $core.secret.passwords.$notification_smtp_password:value
      instance: $mailaas.types.mail.instances.$notification_mail:uuid

  # Compute
  $core.compute.nodes:
    notification_cp:
      name: notification-cp
      project_id: "12345678-c625-4fee-81d5-f691897b8142"
      cores: 1
      ram: 1024
      disk_spec:
        kind: "disks"
        disks:
          - size: 10
            image: "{{ repository | default('https://repository.genesis-core.tech/exordos-elements') }}/exordos_notification/{{ version }}/images/exordos-notification.raw.zst"
            label: root

  # Config
  $core.config.configs:
    notification_cp_config:
      project_id: "12345678-c625-4fee-81d5-f691897b8142"
      path: /etc/exordos_init.txt
      target:
        kind: node
        node: $core.compute.nodes.$notification_cp:uuid
      body:
        kind: text
        content: |
          f"
          IAM_USER_NAME={$core.iam.users.$notification_user:username}
          IAM_USER_PASS={$core.secret.passwords.$notification_user_password:value}
          GC_PG_USER={$dbaas.types.postgres.instances.$notification_cluster_pg.users.$notification_db_user:name}
          GC_PG_PASS={$core.secret.passwords.$notification_db_password:value}
          GC_PG_DB={$dbaas.types.postgres.instances.$notification_cluster_pg.databases.$notification_db:name}
          GC_PG_ENDPOINTS={$dbaas.types.postgres.instances.$notification_cluster_pg:join(ipsv4)}
          GC_HS256_JWKS_ENCRYPTION_KEY={$exordos_notification.imports.$var_hs256_jwks_encryption_key:value}
          AUDIENCE={$exordos_notification.imports.$var_iam_default_client_id:value}
          "

    # Wire core's IAM user-api to push events to this notification service.
    # Instead of coupling core to a VS variable, we deliver the stock gcl_sdk
    # HTTP event client configuration directly onto the core node(s) as config
    # drop-ins:
    #   * event_type_mapping.yaml  — maps core event KINDs to our event_type UUIDs
    #   * exordos_core.d/90-notification-events.conf — enables the [events]
    #     section (client_type=http + our endpoint), loaded via the
    #     `--config-dir /etc/exordos_core/exordos_core.d` of ec-user-api.
    # ec-user-api is restarted on change so the new client takes effect.
    # The notification /v1/events endpoint skips auth, so the API token below is
    # a placeholder and no IAM token has to be provisioned into core.
    core_event_type_mapping:
      project_id: "12345678-c625-4fee-81d5-f691897b8142"
      path: /etc/exordos_core/event_type_mapping.yaml
      target:
        kind: node_set
        # core_set (fixed UUID in core.yaml.j2)
        node_set: "70c88222-b4d9-46c3-9340-aa5bfaaa4b94"
      on_change:
        kind: shell
        # Restart only once BOTH drop-ins are in place. The mapping and the
        # [events] conf are two independent config renders applied in arbitrary
        # order; guarding both on_change hooks on the presence of both files
        # ensures ec-user-api is restarted exactly once (when the second file
        # arrives) and never starts with [events] enabled but no mapping
        # (which would crash build_client).
        command: >-
          test -f /etc/exordos_core/event_type_mapping.yaml &&
          test -f /etc/exordos_core/exordos_core.d/90-notification-events.conf &&
          systemctl restart ec-user-api && systemctl restart ec-gservice || true
      body:
        kind: text
        content: |
          EventTypeMapping:
              # exordos_core RegistrationEventPayload.KIND ->
              # notification email_confirmation event_type UUID
              IamUserRegistration: e0fe8070-e59c-4347-8df1-b3f638c06565
    core_events_conf:
      project_id: "12345678-c625-4fee-81d5-f691897b8142"
      path: /etc/exordos_core/exordos_core.d/90-notification-events.conf
      target:
        kind: node_set
        node_set: "70c88222-b4d9-46c3-9340-aa5bfaaa4b94"
      on_change:
        kind: shell
        command: >-
          test -f /etc/exordos_core/event_type_mapping.yaml &&
          test -f /etc/exordos_core/exordos_core.d/90-notification-events.conf &&
          systemctl restart ec-user-api && systemctl restart ec-gservice || true
      body:
        kind: text
        content: |
          [events]
          enabled = true
          exordos_notification_endpoint = http://notification-cp.local.genesis-core.tech:8080

  $core.vs.variables:
    mail_domain:
      name: "notification_mail_domain"
      project_id: "12345678-c625-4fee-81d5-f691897b8142"
      setter:
        kind: selector
        selector_strategy: latest
    noreply_address:
      name: "notification_noreply_address"
      project_id: "12345678-c625-4fee-81d5-f691897b8142"
      setter:
        kind: selector
        selector_strategy: latest

  # NOTE: mail_domain and noreply_address VS variables have no default values —
  # they are installation-specific. Set them via the separate per-installation
  # manifest (see site_config.yaml.j2). Until set, smtp_via_mailaas will stay NEW.

  # DNS
  $exordos_notification.imports.$core_local_domain.records:
    notification_cp:
      domain: "$exordos_notification.imports.$core_local_domain:uuid"
      project_id: "12345678-c625-4fee-81d5-f691897b8142"
      type: "A"
      record:
        kind: "A"
        name: "notification-cp"
        address: "$core.compute.nodes.$notification_cp:default_network:ipv4"

  # Notification EM resources — synced by EMSyncAgent into notification DB
  $exordos_notification.types.email.providers:
    smtp_via_mailaas:
      project_id: "12345678-c625-4fee-81d5-f691897b8142"
      name: "smtp_via_mailaas"
      description: "SMTP via mailaas exim4 relay"
      status: "ACTIVE"
      protocol:
        kind: StartTlsSMTP
        host: f"{$mailaas.types.mail.instances.$notification_mail:join(ipsv4)}"
        port: 587
        noreply_email_address: f"{$core.vs.variables.$noreply_address:value}"
        user: f"smtp@{$core.vs.variables.$mail_domain:value}"
        password: $core.secret.passwords.$notification_smtp_password:value
        skip_tls_verify: true

  $exordos_notification.types.email.event_types:
    email_confirmation:
      uuid: "e0fe8070-e59c-4347-8df1-b3f638c06565"
      project_id: "12345678-c625-4fee-81d5-f691897b8142"
      name: "email_confirmation"
      description: "User email address confirmation"
      status: "ACTIVE"

  # NOTE: the email templates themselves (letter subject/body) are
  # installation-configurable content and live in the separate
  # site_config.yaml.j2 manifest, which imports the provider and event_type
  # exported below.

exports:
  mail_domain:
    link: "$core.vs.variables.$mail_domain"
  noreply_address:
    link: "$core.vs.variables.$noreply_address"
  email_provider:
    link: "$exordos_notification.types.email.providers.$smtp_via_mailaas"
  email_confirmation_event_type:
    link: "$exordos_notification.types.email.event_types.$email_confirmation"

imports:
  pg18:
    element: "$dbaas"
    kind: "resource"
    link: "$dbaas.types.postgres.versions.$pg18"
  core_local_domain:
    element: "$core"
    kind: "resource"
    link: "$core.dns.domains.$local_domain"
  var_hs256_jwks_encryption_key:
    element: "$core"
    kind: "resource"
    link: "$core.vs.variables.$hs256_jwks_encryption_key"
  var_iam_default_client_id:
    element: "$core"
    kind: "resource"
    link: "$core.vs.variables.$iam_default_client_id"
  exim4_1:
    element: "$mailaas"
    kind: "resource"
    link: "$mailaas.types.mail.versions.$exim4_1"
