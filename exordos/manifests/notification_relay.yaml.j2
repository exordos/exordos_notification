# Site-specific forwarding transport. Only upstream IAM credentials are needed here.
# Deliver private credential files separately as restricted Core config resources.
name: "notification_relay"
description: "Workspace mobile push transport"
schema_version: 1
version: "{{ version | default('1.0.0') }}"
api_version: "v1"
requirements:
  exordos_notification:
    from_version: "1.2.8-dev"
imports:
  backend_node:
    element: "$exordos_notification"
    kind: resource
    link: "$core.compute.nodes.$notification_cp"
resources:
  $core.config.configs:
    source_identity:
      project_id: "12345678-c625-4fee-81d5-f691897b8142"
      path: /etc/exordos_notification/exordos_notification.conf.d/90-mobile-push.conf
      mode: "0600"
      target:
        kind: node
        node: $notification_relay.imports.$backend_node:uuid
      on_change:
        kind: shell
        command: systemctl restart exordos-notification-user-api exordos-notification-builder-agent exordos-notification-mail-agent
      body:
        kind: text
        content: |
          [push]
          local_organization_uuid = {{ organization_uuid }}

  $exordos_notification.types.email.providers:
    mobile_push:
      project_id: "12345678-c625-4fee-81d5-f691897b8142"
      name: "Mobile push"
      description: "Encrypted Workspace mobile push"
      status: ACTIVE
      protocol:
        kind: "notification"

        endpoint: "{{ notification_endpoint }}"
        auth_file: /etc/exordos_notification/mobile-push-auth.json


  $exordos_notification.types.email.event_types:
    workspace_message_create:
      uuid: "864b5689-2675-5cbf-b545-5307fa158449"
      project_id: "12345678-c625-4fee-81d5-f691897b8142"
      name: workspace_message_create
      status: ACTIVE
    workspace_message_cancelled:
      uuid: "90492b40-2a35-56aa-8821-82d383fe8730"
      project_id: "12345678-c625-4fee-81d5-f691897b8142"
      name: workspace_message_cancelled
      status: ACTIVE

  $exordos_notification.types.email.templates:

    workspace_message_create:
      project_id: "12345678-c625-4fee-81d5-f691897b8142"
      name: "workspace_message_create mobile push"
      status: ACTIVE
      provider: $exordos_notification.types.email.providers.$mobile_push:uuid
      event_type: $exordos_notification.types.email.event_types.$workspace_message_create:uuid
      is_default: true
      params: {}
      content:
        kind: "notification"

    workspace_message_cancelled:
      project_id: "12345678-c625-4fee-81d5-f691897b8142"
      name: "workspace_message_cancelled mobile push"
      status: ACTIVE
      provider: $exordos_notification.types.email.providers.$mobile_push:uuid
      event_type: $exordos_notification.types.email.event_types.$workspace_message_cancelled:uuid
      is_default: true
      params: {}
      content:
        kind: "notification"

