name: "notification_firebase"
description: "Firebase transport for Exordos Notification"
schema_version: 1
version: "{{ version }}"
api_version: "v1"

requirements:
  exordos_notification:
    from_version: "2.0.3-dev"

resources:
  # The transport owns only the shared provider. Event types, templates and
  # sender identities belong to the producer element, as with email.
  $exordos_notification.types.email.providers:
    firebase:
      project_id: "12345678-c625-4fee-81d5-f691897b8142"
      name: "firebase"
      description: "Firebase Cloud Messaging data transport"
      protocol:
        kind: "firebase"
        ttl_seconds: 3600

exports:
  firebase_provider:
    link: "$exordos_notification.types.email.providers.$firebase"
