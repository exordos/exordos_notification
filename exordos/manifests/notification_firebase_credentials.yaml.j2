name: notification_firebase_credentials
description: Deliver the Firebase service account to the Notification node
schema_version: 1
version: "{{ version }}"
api_version: v1

requirements:
  exordos_notification:
    from_version: "2.0.4-dev"
  notification_firebase:
    from_version: "2.0.4-dev"
  notification_firebase_secret:
    from_version: "2.0.4-dev"

imports:
  notification_node:
    element: "$exordos_notification"
    kind: resource
    link: "$core.compute.nodes.$notification_cp"
  service_account:
    element: "$notification_firebase_secret"
    kind: resource
    link: "$core.secret.secrets.$service_account"

resources:
  $core.config.configs:
    service_account:
      project_id: "12345678-c625-4fee-81d5-f691897b8142"
      path: /etc/exordos_notification/firebase-service-account.json
      owner: root
      group: root
      mode: "0600"
      target:
        kind: node
        node: $notification_firebase_credentials.imports.$notification_node:uuid
      body:
        kind: text
        content: $notification_firebase_credentials.imports.$service_account:value
      on_change:
        kind: shell
        command: systemctl try-restart exordos-notification-mail-agent.service
